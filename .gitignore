# Generated CAD output — regenerate with:
#   py -3.12 -m src.build
#   py -3.12 -m src.backpack_housing
# (root-level .step only; reference inputs in references/ are tracked)
/*.step

# Python bytecode cache
__pycache__/
*.pyc

# Mutable build counter (floated as 3D text on each assembly)
tools/build_counter.txt

# PlatformIO build output — regenerate with: pio run
firmware/.pio/

# WiFi / OTA credentials — local only
firmware/src/secrets.h

# Generated board output — regenerate with: py -3.12 elec/main.py && finish.py
elec/out/

# finish.py drops its DRC report in the repo root, not in elec/out
*-drc.rpt

# SKiDL scratch logs from elec/main.py — regenerated every run, and they
# record absolute local paths
skidl_REPL.erc
skidl_REPL.log

# Footprint generators keep a one-deep backup beside their output so a bad run can
# be diffed against the last good one. It is a working file, not a source: the
# generator IS the source and re-running it reproduces the .kicad_mod exactly.
*.kicad_mod.prev
