/*
 * Copy this file to `secrets.h` and fill in your own values.
 * `secrets.h` is gitignored — it never gets committed.
 */
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Hostname on the LAN. The board answers to <NET_HOSTNAME>.local via mDNS,
// and this is also the OTA target name shown to PlatformIO / espota.
#define NET_HOSTNAME  "watering-backpack"

// Required to push an OTA firmware update.
// Leave it as "" to disable authentication entirely — convenient, but then any
// device on your LAN can reflash the board (which drives a water pump).
#define OTA_PASSWORD  ""
